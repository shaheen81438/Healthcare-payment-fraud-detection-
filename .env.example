# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pi_user
POSTGRES_PASSWORD=pi_password_change_me
POSTGRES_DB=payment_integrity

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT=claims-risk

# --- Application ---
ENV=dev
LOG_LEVEL=INFO
API_PORT=8000
DASHBOARD_PORT=8501
BATCH_PREDICT_LIMIT=1000
MODEL_ARTIFACTS_DIR=models
RANDOM_SEED=42

# --- Data ---
# Year of the CMS Medicare Physician & Other Practitioners dataset to ingest.
CMS_DATA_YEAR=2023
